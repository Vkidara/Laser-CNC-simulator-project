--- !u!114 &944707388
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 944707387}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d5a19a85d9c591b4aaf7b57ddcfa4fbb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  bookPanel: {fileID: 1041946767}
  pageText: {fileID: 458579370}
  nextPageButton: {fileID: 1533247299}
  prevPageButton: {fileID: 415625994}
  exitButton: {fileID: 2145414943}
  playerMovement: {fileID: 154126564}
  pages:
  - "\n\n\n\n\n\n\n\n\u041A\u0440\u0430\u0442\u043A\u043E\u0435 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E
    \u043F\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044E
    \u043B\u0430\u0437\u0435\u0440\u043D\u043E\u0433\u043E \u0441\u0442\u0430\u043D\u043A\u0430
    \u0434\u043B\u044F \u0433\u0440\u0430\u0432\u0438\u0440\u043E\u0432\u043A\u0438"
  - "\U0001F539 1. \u0412\u0432\u0435\u0434\u0435\u043D\u0438\u0435: \u0427\u0442\u043E
    \u0442\u0430\u043A\u043E\u0435 \u043B\u0430\u0437\u0435\u0440\u043D\u044B\u0439
    \u0433\u0440\u0430\u0432\u0451\u0440?\r\n\r\n\t\u041B\u0430\u0437\u0435\u0440\u043D\u044B\u0439
    \u0433\u0440\u0430\u0432\u0438\u0440\u043E\u0432\u0430\u043B\u044C\u043D\u044B\u0439
    \u0441\u0442\u0430\u043D\u043E\u043A \u2014 \u044D\u0442\u043E \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E,
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0449\u0435\u0435 \u0441\u0444\u043E\u043A\u0443\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u043B\u0443\u0447 \u0441\u0432\u0435\u0442\u0430 \u0432\u044B\u0441\u043E\u043A\u043E\u0439
    \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u0438 \u0434\u043B\u044F \u0442\u0435\u0440\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0438 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
    \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430. \u0412 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435
    \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u043B\u0430\u0437\u0435\u0440\u0430
    \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442 \u0438\u0441\u043F\u0430\u0440\u0435\u043D\u0438\u0435,
    \u043E\u0431\u0443\u0433\u043B\u0438\u0432\u0430\u043D\u0438\u0435 \u0438\u043B\u0438
    \u043E\u043F\u043B\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0432\u0435\u0440\u0445\u043D\u0435\u0433\u043E
    \u0441\u043B\u043E\u044F, \u0444\u043E\u0440\u043C\u0438\u0440\u0443\u044F \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435,
    \u043D\u0430\u0434\u043F\u0438\u0441\u044C \u0438\u043B\u0438 \u0443\u0437\u043E\u0440."
  - "\U0001F539 2. \u041F\u0440\u0438\u043D\u0446\u0438\u043F \u0440\u0430\u0431\u043E\u0442\u044B
    \u043B\u0430\u0437\u0435\u0440\u0430\r\n\r\n\t\u041B\u0430\u0437\u0435\u0440
    (\u043E\u0442 \u0430\u043D\u0433\u043B. Light Amplification by Stimulated Emission
    of Radiation) \u2014 \u044D\u0442\u043E \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A
    \u043C\u043E\u043D\u043E\u0445\u0440\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043A\u043E\u0433\u0435\u0440\u0435\u043D\u0442\u043D\u043E\u0433\u043E \u0441\u0432\u0435\u0442\u0430.
    \u0415\u0433\u043E \u044D\u043D\u0435\u0440\u0433\u0438\u044F \u043C\u043E\u0436\u0435\u0442
    \u0431\u044B\u0442\u044C \u0441\u0444\u043E\u043A\u0443\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u0430
    \u0432 \u0442\u043E\u0447\u043A\u0443 \u043C\u0435\u043D\u0435\u0435 0.1 \u043C\u043C
    \u0434\u0438\u0430\u043C\u0435\u0442\u0440\u043E\u043C, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044F
    \u0432\u044B\u0441\u043E\u043A\u0443\u044E \u043F\u043B\u043E\u0442\u043D\u043E\u0441\u0442\u044C
    \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u0438.\r\n\r\n\t\u0421\u0442\u0430\u043D\u043A\u0438
    \u0447\u0430\u0449\u0435 \u0432\u0441\u0435\u0433\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442
    \u043E\u0434\u0438\u043D \u0438\u0437 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0445
    \u0442\u0438\u043F\u043E\u0432 \u043B\u0430\u0437\u0435\u0440\u043E\u0432:\r\n\r\n   
    CO\u2082-\u043B\u0430\u0437\u0435\u0440 \u2014 \u0434\u043B\u044F \u043D\u0435\u043C\u0435\u0442\u0430\u043B\u043B\u043E\u0432
    (\u0434\u0435\u0440\u0435\u0432\u043E, \u043A\u043E\u0436\u0430, \u0430\u043A\u0440\u0438\u043B);\r\n\r\n   
    \u0412\u043E\u043B\u043E\u043A\u043E\u043D\u043D\u044B\u0439 \u043B\u0430\u0437\u0435\u0440
    (fiber laser) \u2014 \u0434\u043B\u044F \u043C\u0435\u0442\u0430\u043B\u043B\u043E\u0432;\r\n\r\n   
    UV-\u043B\u0430\u0437\u0435\u0440 \u2014 \u0434\u043B\u044F \u043C\u0438\u043A\u0440\u043E\u0433\u0440\u0430\u0432\u0438\u0440\u043E\u0432\u043A\u0438
    (\u0441\u0442\u0435\u043A\u043B\u043E, \u043A\u0435\u0440\u0430\u043C\u0438\u043A\u0430,
    \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u0438\u043A\u0430)."
  - "\U0001F539 3. \u041E\u0441\u043D\u043E\u0432\u043D\u044B\u0435 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B
    \u0433\u0440\u0430\u0432\u0438\u0440\u043E\u0432\u043A\u0438\r\n\u2705 \u041C\u043E\u0449\u043D\u043E\u0441\u0442\u044C
    (Power)\r\n\r\n\u0412\u044B\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044F \u0432
    \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u0430\u0445 \u0438\u043B\u0438 \u0432\u0430\u0442\u0442\u0430\u0445
    \u0438 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442 \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0441\u0442\u044C
    \u043B\u0430\u0437\u0435\u0440\u043D\u043E\u0433\u043E \u0438\u0437\u043B\u0443\u0447\u0435\u043D\u0438\u044F.\r\n\r\n   
    \u0412\u044B\u0441\u043E\u043A\u0430\u044F \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u044C:
    \u0431\u043E\u043B\u0435\u0435 \u0433\u043B\u0443\u0431\u043E\u043A\u0430\u044F
    \u0438 \u0442\u0451\u043C\u043D\u0430\u044F \u0433\u0440\u0430\u0432\u0438\u0440\u043E\u0432\u043A\u0430,
    \u0440\u0438\u0441\u043A \u043E\u0436\u043E\u0433\u0430.\r\n\r\n    \u041D\u0438\u0437\u043A\u0430\u044F
    \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u044C: \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u043D\u0430\u044F,
    \u0441\u0432\u0435\u0442\u043B\u0430\u044F \u0433\u0440\u0430\u0432\u0438\u0440\u043E\u0432\u043A\u0430.\r\n\r\n\u2705
    \u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C (Speed)\r\n\r\n\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C
    \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u044F \u043B\u0430\u0437\u0435\u0440\u043D\u043E\u0439
    \u0433\u043E\u043B\u043E\u0432\u043A\u0438, \u0438\u0437\u043C\u0435\u0440\u044F\u0435\u0442\u0441\u044F
    \u0432 \u043C\u043C/\u0441 \u0438\u043B\u0438 %.\r\n\r\n    \u0412\u044B\u0441\u043E\u043A\u0430\u044F
    \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C: \u0441\u043D\u0438\u0436\u0430\u0435\u0442
    \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435, \u0434\u0435\u043B\u0430\u0435\u0442
    \u0433\u0440\u0430\u0432\u0438\u0440\u043E\u0432\u043A\u0443 \u0441\u0432\u0435\u0442\u043B\u0435\u0435.\r\n\r\n   
    \u041C\u0435\u0434\u043B\u0435\u043D\u043D\u0430\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C:
    \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442 \u044D\u043A\u0441\u043F\u043E\u0437\u0438\u0446\u0438\u044E,
    \u0434\u0435\u043B\u0430\u0435\u0442 \u0433\u0440\u0430\u0432\u0438\u0440\u043E\u0432\u043A\u0443
    \u0433\u043B\u0443\u0431\u0436\u0435.\r\n\r"
  - "\u2705 \u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043F\u0440\u043E\u0445\u043E\u0434\u043E\u0432
    (Passes)\r\n\r\n\u0427\u0438\u0441\u043B\u043E \u0440\u0430\u0437, \u043A\u043E\u0433\u0434\u0430
    \u043B\u0430\u0437\u0435\u0440 \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E
    \u043E\u0431\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442 \u0442\u043E\u0442
    \u0436\u0435 \u043A\u043E\u043D\u0442\u0443\u0440.\r\n\r\n    \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
    \u0434\u043B\u044F \u0443\u0441\u0438\u043B\u0435\u043D\u0438\u044F \u044D\u0444\u0444\u0435\u043A\u0442\u0430
    \u0431\u0435\u0437 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u044F
    \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u0438.\r\n\r\n\u2696 \u0421\u043E\u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0435
    \u201C\u043C\u043E\u0449\u043D\u043E\u0441\u0442\u044C / \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C\u201D\r\n\r\n\u042D\u0442\u043E
    \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439 \u0444\u0430\u043A\u0442\u043E\u0440,
    \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u044E\u0449\u0438\u0439 \u044D\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u043F\u043B\u043E\u0442\u043D\u043E\u0441\u0442\u044C \u043D\u0430 \u0435\u0434\u0438\u043D\u0438\u0446\u0443
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438:\n\r\nE=PS\r\u200B\r\n\r\n\u0427\u0435\u043C
    \u0432\u044B\u0448\u0435 EE, \u0442\u0435\u043C \u0433\u043B\u0443\u0431\u0436\u0435/\u0442\u0435\u043C\u043D\u0435\u0435
    \u0433\u0440\u0430\u0432\u0438\u0440\u043E\u0432\u043A\u0430."
  - "\U0001F539 4. \u041C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B \u0438
    \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B \u0433\u0440\u0430\u0432\u0438\u0440\u043E\u0432\u043A\u0438\r\n\u041C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\t\u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u043C\u0430\u044F
    \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u044C\t\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C\t\u041F\u0440\u043E\u0445\u043E\u0434\u043E\u0432\t\u041A\u043E\u043C\u043C\u0435\u043D\u0442\u0430\u0440\u0438\u0439\r\n\u0424\u0430\u043D\u0435\u0440\u0430
    3\u043C\u043C\t60\u201380%\t15\u201330 \u043C\u043C/\u0441\t1\u20132\t\u041B\u0451\u0433\u043A\u043E\u0435
    \u043E\u0431\u0443\u0433\u043B\u0438\u0432\u0430\u043D\u0438\u0435\r\n\u041E\u0440\u0433\u0441\u0442\u0435\u043A\u043B\u043E\t50\u201370%\t20\u201340
    \u043C\u043C/\u0441\t1\t\u0413\u043B\u0430\u0434\u043A\u0438\u0439 \u0441\u0440\u0435\u0437,
    \u0434\u044B\u043C\r\n\u041C\u0435\u0442\u0430\u043B\u043B \u043E\u043A\u0440\u0430\u0448\u0435\u043D\u043D\u044B\u0439\t80\u2013100%\t5\u201315
    \u043C\u043C/\u0441\t3\u20135\t\u0422\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F
    \u0432\u043E\u043B\u043E\u043A\u043E\u043D\u043D\u044B\u0439 \u043B\u0430\u0437\u0435\u0440\r\n\u041A\u043E\u0436\u0430\t30\u201350%\t30\u201350
    \u043C\u043C/\u0441\t1\u20132\t\u0421\u0438\u043B\u044C\u043D\u044B\u0439 \u0437\u0430\u043F\u0430\u0445,
    \u043D\u0443\u0436\u043D\u0430 \u0432\u044B\u0442\u044F\u0436\u043A\u0430\r\n\u0411\u0443\u043C\u0430\u0433\u0430\t10\u201320%\t100+
    \u043C\u043C/\u0441\t1\t\u0412\u044B\u0441\u043E\u043A\u0438\u0439 \u0440\u0438\u0441\u043A
    \u043F\u043E\u0434\u0436\u0438\u0433\u0430\u043D\u0438\u044F"
  - "\U0001F539 5. \u042D\u0442\u0430\u043F\u044B \u0440\u0430\u0431\u043E\u0442\u044B
    \u043D\u0430 \u043B\u0430\u0437\u0435\u0440\u043D\u043E\u043C \u0441\u0442\u0430\u043D\u043A\u0435\r\n\r\n   
    \u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430 \u0447\u0435\u0440\u0442\u0435\u0436\u0430\r\n   
    \u0412\u044B\u0431\u043E\u0440 \u0432\u0435\u043A\u0442\u043E\u0440\u043D\u043E\u0433\u043E
    \u0444\u0430\u0439\u043B\u0430 \u0438\u043B\u0438 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F.
    \u0423\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044C \u0432 \u0435\u0433\u043E
    \u0447\u0451\u0442\u043A\u043E\u0441\u0442\u0438 \u0438 \u043C\u0430\u0441\u0448\u0442\u0430\u0431\u0435.\r\n\r\n   
    \u0412\u044B\u0431\u043E\u0440 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430\r\n   
    \u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0443\u044E
    \u0437\u0430\u0433\u043E\u0442\u043E\u0432\u043A\u0443, \u0438\u0441\u0445\u043E\u0434\u044F
    \u0438\u0437 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u0439 \u043A
    \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u043C\u0443 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0443.\r\n\r\n   
    \u0417\u0430\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435 \u0437\u0430\u0433\u043E\u0442\u043E\u0432\u043A\u0438\r\n   
    \u0423\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044C, \u0447\u0442\u043E \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B
    \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u0435\u043D \u043D\u0430 \u0440\u0430\u0431\u043E\u0447\u0435\u0439
    \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435.\r\n\r\n    \u0412\u044B\u0431\u043E\u0440
    \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u043E\u0432 \u0433\u0440\u0430\u0432\u0438\u0440\u043E\u0432\u043A\u0438\r\n   
    \u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435 \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u044C,
    \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0438 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u043F\u0440\u043E\u0445\u043E\u0434\u043E\u0432 \u0441\u043E\u0433\u043B\u0430\u0441\u043D\u043E
    \u0442\u0438\u043F\u0443 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430.\r\n\r\n    "
  - " \u0424\u043E\u043A\u0443\u0441\u0438\u0440\u043E\u0432\u043A\u0430 \u043B\u0430\u0437\u0435\u0440\u0430\r\n   
    \u041D\u0430\u0441\u0442\u0440\u043E\u0439\u0442\u0435 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435
    \u043E\u0442 \u043B\u0438\u043D\u0437\u044B \u0434\u043E \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
    \u0434\u043B\u044F \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043F\u044F\u0442\u043D\u0430 \u0444\u043E\u043A\u0443\u0441\u0430.\r\n\r\n   
    \u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0438 \u0441\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u044F\r\n   
    \u0417\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \"\u043E\u0431\u0432\u043E\u0434\u043A\u0443\"
    \u043F\u043E \u043A\u043E\u043D\u0442\u0443\u0440\u0443 \u0431\u0435\u0437 \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F
    \u043B\u0430\u0437\u0435\u0440\u0430 (dry-run).\r\n\r\n    \u0421\u0442\u0430\u0440\u0442
    \u0433\u0440\u0430\u0432\u0438\u0440\u043E\u0432\u043A\u0438\r\n    \u0412\u043A\u043B\u044E\u0447\u0438\u0442\u0435
    \u0432\u044B\u0442\u044F\u0436\u043A\u0443 \u0438 \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0439\u0442\u0435
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441.\r\n\r\n    \u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044C
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0430\r\n    \u0421\u043B\u0435\u0434\u0438\u0442\u0435
    \u0437\u0430 \u0434\u044B\u043C\u043E\u043C, \u0437\u0430\u043F\u0430\u0445\u043E\u043C,
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u043C \u0432\u043E\u0441\u043F\u043B\u0430\u043C\u0435\u043D\u0435\u043D\u0438\u0435\u043C.\r\n\r\n   
    \u0417\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435\r\n    \u0414\u0430\u0439\u0442\u0435
    \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0443 \u043E\u0441\u0442\u044B\u0442\u044C,
    \u043E\u0447\u0438\u0441\u0442\u0438\u0442\u0435 \u043E\u0442 \u043A\u043E\u043F\u043E\u0442\u0438."
  - "\U0001F539 6. \u0411\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C
    \u0438 \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u0438\u0435\r\n\U0001F9BA \u041E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435:\r\n\r\n   
    \u0417\u0430\u0449\u0438\u0442\u043D\u044B\u0435 \u043E\u0447\u043A\u0438 (\u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
    \u043F\u0440\u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u043C \u043A\u043E\u0440\u043F\u0443\u0441\u0435
    \u0441\u0442\u0430\u043D\u043A\u0430);\r\n\r\n    \u0412\u044B\u0442\u044F\u0436\u043A\u0430
    / \u0432\u0435\u043D\u0442\u0438\u043B\u044F\u0446\u0438\u044F;\r\n\r\n    \u041F\u043E\u0436\u0430\u0440\u043D\u044B\u0439
    \u0431\u0430\u043B\u043B\u043E\u043D \u0440\u044F\u0434\u043E\u043C;\r\n\r\n   
    \u041F\u043B\u043E\u0442\u043D\u0430\u044F \u043E\u0434\u0435\u0436\u0434\u0430
    \u0431\u0435\u0437 \u0441\u0438\u043D\u0442\u0435\u0442\u0438\u043A\u0438.\r\n\r\n\u274C
    \u041D\u0435\u043B\u044C\u0437\u044F:\r\n\r\n    \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0435 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B
    (PVC \u2014 \u0432\u044B\u0434\u0435\u043B\u044F\u0435\u0442 \u044F\u0434\u043E\u0432\u0438\u0442\u044B\u0439
    \u0445\u043B\u043E\u0440);\r\n\r\n    \u041E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C
    \u0441\u0442\u0430\u043D\u043E\u043A \u0431\u0435\u0437 \u043F\u0440\u0438\u0441\u043C\u043E\u0442\u0440\u0430;\r\n\r\n   
    \u0420\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0431\u0435\u0437 \u0432\u044B\u0442\u044F\u0436\u043A\u0438
    \u0432 \u0437\u0430\u043A\u0440\u044B\u0442\u043E\u043C \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0438."
  - "\U0001F539 7. \u0420\u0430\u0437\u043D\u043E\u0432\u0438\u0434\u043D\u043E\u0441\u0442\u0438
    \u0441\u0442\u0430\u043D\u043A\u043E\u0432\n\r\n\u0422\u0438\u043F\t\u041F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435\t\u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u0438\r\nCO\u2082\t\u041D\u0435\u043C\u0435\u0442\u0430\u043B\u043B\u044B\t\u0411\u043E\u043B\u044C\u0448\u0430\u044F
    \u0434\u043B\u0438\u043D\u0430 \u0432\u043E\u043B\u043D\u044B (10.6 \u043C\u043A\u043C)\r\n\u0412\u043E\u043B\u043E\u043A\u043E\u043D\u043D\u044B\u0439\t\u041C\u0435\u0442\u0430\u043B\u043B\u044B,
    \u043F\u043B\u0430\u0441\u0442\u0438\u043A\t\u0412\u044B\u0441\u043E\u043A\u0430\u044F
    \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C, \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u044C\r\nUV-\u043B\u0430\u0437\u0435\u0440\t\u042D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u0438\u043A\u0430,
    \u0441\u0442\u0435\u043A\u043B\u043E\t\u041C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0439
    \u043D\u0430\u0433\u0440\u0435\u0432, \u043C\u0438\u043A\u0440\u043E\u0441\u043A\u043E\u043F\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C"
  - "\U0001F539 8. \u0418\u0442\u043E\u0433\r\n\r\n\u0420\u0430\u0431\u043E\u0442\u0430
    \u043D\u0430 \u043B\u0430\u0437\u0435\u0440\u043D\u043E\u043C \u0441\u0442\u0430\u043D\u043A\u0435
    \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043A\u0430\u043A \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0438, \u0442\u0430\u043A
    \u0438 \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u044F \u0444\u0438\u0437\u0438\u043A\u0438
    \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
    \u0441\u0432\u0435\u0442\u0430 \u0441 \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u043E\u043C.
    \u0412 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0435 \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u044F
    \u0432\u0430\u0436\u043D\u043E \u043E\u0441\u0432\u043E\u0438\u0442\u044C:\r\n\r\n   
    \u043F\u043E\u0434\u0431\u043E\u0440 \u043E\u043F\u0442\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0445
    \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u043E\u0432;\r\n\r\n    \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0435
    \u043C\u0435\u0442\u043E\u0434\u044B \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u0438;\r\n\r\n   
    \u0430\u043D\u0430\u043B\u0438\u0437 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0430
    \u043F\u043E \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u044B\u043C \u043F\u0440\u0438\u0437\u043D\u0430\u043A\u0430\u043C.\r\n\r\n\t\u041F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u0435
    \u044D\u0442\u0438\u0445 \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u043E\u0432
    \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442 \u0432\u0430\u043C \u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F
    \u0447\u0451\u0442\u043A\u043E\u0439, \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0439
    \u0438 \u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0443\u0435\u043C\u043E\u0439
    \u0433\u0440\u0430\u0432\u0438\u0440\u043E\u0432\u043A\u0438 \u043D\u0430 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445
    \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430\u0445."
