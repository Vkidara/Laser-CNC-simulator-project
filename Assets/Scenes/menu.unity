  level2Preview: {fileID: 21300000, guid: e333eee3502e6b941bde59bb2908b85a, type: 3}
  level1Description: "\u041D\u0430 \u043F\u0435\u0440\u0432\u043E\u043C \u044D\u0442\u0430\u043F\u0435
    \u043E\u0431\u0443\u0447\u0430\u044E\u0449\u0438\u0439\u0441\u044F \u0434\u043E\u043B\u0436\u0435\u043D
    \u0441\u043E\u0431\u043B\u044E\u0434\u0430\u044F \u0442\u0435\u0445\u043D\u0438\u043A\u0443
    \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438 \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0441\u0442\u0438
    \u0433\u0440\u0430\u0432\u0438\u0440\u043E\u0432\u043A\u0443 \u043D\u0430 \u043B\u0430\u0437\u0435\u0440\u043D\u043E\u043C
    \u0441\u0442\u0430\u043D\u043A\u0435 "
  level2Description: "\u041D\u0430 \u0432\u0442\u043E\u0440\u043E\u043C \u044D\u0442\u0430\u043F\u0435
    \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u044F \u0443\u0447\u0435\u043D\u0438\u043A
    \u0434\u043E\u043B\u0436\u0435\u043D \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0441\u0442\u0438
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441 \u0440\u0435\u0437\u043A\u0438 \u043D\u0430
    \u043B\u0430\u0437\u0435\u0440\u043D\u043E\u043C \u0441\u0442\u0430\u043D\u043A\u0435,
    \u0441\u043E\u0431\u043B\u044E\u0434\u0430\u044F \u0442\u0435\u0445\u043D\u0438\u043A\u0443
    \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438."
